# Infrastructure
RAG_POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/rag
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=chunks_v1
RAG_REDIS_URL=redis://localhost:6379/0

# Security
# 留空 = 关闭鉴权（单机开发）。一旦设置，所有 /v1 请求都要求
# `Authorization: Bearer <key>`。对外暴露时必须设置。
RAG_API_KEY=
# 上传单文件大小上限（字节，默认 50 MiB）。超限返回 413。
RAG_MAX_UPLOAD_BYTES=52428800
# /v1/query 全局并发上限。单次查询最坏触发 ~7 次外部调用，
# 不限流会让 LLM 配额被并发请求烧穿。
RAG_QUERY_MAX_CONCURRENCY=8
# 出站 provider 地址默认禁止指向私网 / 云元数据地址（防 SSRF）。
# 内网自建推理服务需要显式打开。
RAG_ALLOW_PRIVATE_BASE_URL=false

# Database connection pool
RAG_DB_POOL_SIZE=10
RAG_DB_MAX_OVERFLOW=20
RAG_DB_POOL_TIMEOUT=30
RAG_DB_POOL_RECYCLE=1800

# LLM (OpenAI-compatible)
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=
RAG_LLM_TIMEOUT_SECONDS=120

# Embedding (OpenAI-compatible)
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_MODEL_VERSION=v1
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_TIMEOUT_SECONDS=60

# Reranker (optional; provider "none" disables it)
RAG_RERANKER_PROVIDER=none
RAG_RERANKER_MODEL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_BASE_URL=
RAG_RERANKER_TIMEOUT_SECONDS=30

# Provider retry (transient network / 5xx / 429)
RAG_PROVIDER_MAX_ATTEMPTS=3
RAG_PROVIDER_RETRY_BACKOFF_SECONDS=1.0

# Retrieval parameters (06-retrieval-spec section 12)
RAG_TOP_K_VECTOR=50
RAG_TOP_K_KEYWORD=50
RAG_RRF_K=60
RAG_CANDIDATE_LIMIT=50
RAG_RERANK_TOP_N=10
RAG_PER_VERSION_CAP=5
RAG_MAX_SUB_QUERIES=4
# Optional min score threshold; leave unset to disable (evidence check decides)
# RAG_MIN_SCORE=

# Chunking / context
RAG_MAX_CHUNK_TOKENS=512
RAG_CONTEXT_TOKEN_BUDGET=6000
# Parent/child chunks (04 section 17.1): children are indexed,
# parents provide full context on hit
RAG_PARENT_CHUNK_TOKENS=1200
RAG_CONTEXT_EXPAND_TO_PARENT=true
# Semantic split (04 section 15.1): off by default; enabling costs
# extra embedding calls during ingestion
RAG_SEMANTIC_SPLIT_ENABLED=false
RAG_SEMANTIC_SPLIT_THRESHOLD=0.5

# Prompt loading
RAG_PROMPT_CACHE_TTL_SECONDS=5

# Agent (autonomous tool calling, /v1/agent)
# 需要可选依赖：pip install 'langchain-core>=0.3' 'langchain-openai>=0.2'
# 未安装时 /v1/agent 返回 503，/v1/query 不受影响。
RAG_AGENT_ENABLED=true
# ReAct 循环最大步数；防止 LLM 反复调用工具不收敛
RAG_AGENT_MAX_ITERATIONS=8
# 单次工具调用返回给 LLM 的最大片段数
RAG_AGENT_TOOL_TOP_K=5
# 单轮 Agent 请求的 wall-clock 上限（秒）
RAG_AGENT_TIMEOUT_SECONDS=180

# Ingestion worker resilience
RAG_INGESTION_MAX_ATTEMPTS=3
RAG_INGESTION_RETRY_BACKOFF_SECONDS=30
RAG_INGESTION_STALE_JOB_TIMEOUT_SECONDS=300
RAG_INGESTION_POLL_INTERVAL_SECONDS=2
# Redis queue fast path for the worker; set false for pure DB polling
RAG_REDIS_QUEUE_ENABLED=true
RAG_INGESTION_WORKER_CONCURRENCY=4
RAG_CLEANUP_BATCH_SIZE=200
