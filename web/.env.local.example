# FastAPI backend that Next rewrites /v1 requests to (dev proxy).
BACKEND_URL=http://localhost:8000

# If the backend sets RAG_API_KEY (app/api/deps.py require_api_key), set the
# SAME value here. Next middleware injects it as `Authorization: Bearer` on
# /v1 requests server-side, so it never reaches the client bundle.
# RAG_API_KEY=
